<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="QuizMatematica.OitavaQpage"
    Title="Pergunta 8">

    <ScrollView>
        <VerticalStackLayout Padding="25" Spacing="18">

            <Label Text="Pergunta 8 de 8"
                   FontSize="24"
                   FontAttributes="Bold"
                   HorizontalTextAlignment="Center"
                   TextColor="#19376D" />

            <Label Text="DIVISÃO"
                   FontSize="18"
                   HorizontalTextAlignment="Center"
                   TextColor="#405675" />

            <BoxView HeightRequest="2"
                     Color="#C8D5E8" />

            <Label Text="Quanto é 81 ÷ 9?"
                   FontSize="25"
                   FontAttributes="Bold"
                   HorizontalTextAlignment="Center"
                   TextColor="#19376D" />

            <RadioButton x:Name="RespostaA"
                         Content="A) 7"
                         GroupName="Pergunta8"
                         TextColor="#333333" />

            <RadioButton x:Name="RespostaB"
                         Content="B) 8"
                         GroupName="Pergunta8"
                         TextColor="#333333" />

            <RadioButton x:Name="RespostaC"
                         Content="C) 9"
                         GroupName="Pergunta8"
                         TextColor="#333333" />

            <RadioButton x:Name="RespostaD"
                         Content="D) 10"
                         GroupName="Pergunta8"
                         TextColor="#333333" />

            <BoxView HeightRequest="1"
                     Color="#C8D5E8" />

            <Label x:Name="lblPontuacao"
                   Text="Pontuação: 0"
                   FontSize="18"
                   HorizontalTextAlignment="Center"
                   TextColor="#405675" />

            <Button Text="Finalizar quiz"
                    FontSize="17"
                    FontAttributes="Bold"
                    HeightRequest="55"
                    CornerRadius="12"
                    BackgroundColor="#19376D"
                    TextColor="White"
                    Clicked="OnClicked" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>